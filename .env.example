# 이름만 적는다. 실제 값은 .env (git 제외) 또는 서버 비밀값으로. 비워 두면 코드 기본값.

# memory (기본, DB 없음) | pgvector
RAG_BACKEND=
# 지식 문서 폴더 (기본: 설치된 패키지 안의 knowledge/)
RAG_KNOWLEDGE_DIR=

# pgvector (기본: 백엔드 compose.yaml 의 로컬 DB, 127.0.0.1:54329)
RAG_DATABASE_URL=
RAG_MIN_SCORE=

# 임베딩 (OpenAIEmbedder). 키 이름은 백엔드 서버 설정과 같다
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIM=
OPENAI_API_KEY=

# 테스트 전용: 지우고 다시 만들어도 되는 DB
RAG_TEST_DATABASE_URL=
# 계약 테스트가 옆 레포를 못 찾을 때 경로 지정
RAG_AGENT_DIR=
RAG_BACKEND_DIR=
