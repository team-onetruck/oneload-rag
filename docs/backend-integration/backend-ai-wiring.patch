+def _ai_collaborators() -> tuple[Agent | None, VisionExtractor | None]:
+    """AI_MODE=llm: R2 agent + vision with R3 knowledge search. The same vision serves /messages photos and
+    /localizations. Imported lazily so tests and AI_MODE=rule need none of the AI packages."""
+    if get_settings().ai_mode != "llm":
+        return None, None
+    from hangil_r2 import LLMAgent, LLMVision, OpenAILLM
+    from hangil_rag import search_knowledge
+
+    llm = OpenAILLM()
+    vision = LLMVision(llm)
+    return LLMAgent(llm, search_knowledge=search_knowledge, vision=vision, fallback=RuleAgent()), vision
+
+
+_agent, _vision = _ai_collaborators()
+app = create_app(agent=_agent, vision=_vision)
